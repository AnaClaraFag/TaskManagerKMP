CREATE TABLE Task(
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    title TEXT NOT NULL,
    description TEXT NOT NULL DEFAULT '',
    isCompleted INTEGER AS kotlin.Boolean NOT NULL DEFAULT 0,
    createdAt TEXT NOT NULL,
    updatedAt TEXT NOT NULL
);

selectAll:
SELECT * FROM Task ORDER BY createdAt DESC;

selectById:
SELECT * FROM Task WHERE id = ?;

selectByStatus:
SELECT * FROM Task WHERE isCompleted = ? ORDER BY createdAt DESC;

insert:
INSERT INTO Task (title, description, isCompleted, createdAt, updatedAt)
VALUES (?, ?, ?, ?, ?);

update:
UPDATE Task SET title = ?, description = ?, isCompleted = ?, updatedAt = ? WHERE id = ?;

delete:
DELETE FROM Task WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();
